# ============================================================================
# EMQX Cloud Serverless - MQTT Broker
# ============================================================================
MQTT_BROKER=ie0e7e23.ala.cn-shenzhen.emqxsl.cn
MQTT_PORT=8883
MQTT_USERNAME=root
MQTT_PASSWORD=your_password_here

# ----------------------------------------------------------------------------
# Optional MQTT tunables (defaults shown)
# ----------------------------------------------------------------------------
MQTT_CLIENT_ID=andy-studio-server
MQTT_TOPIC_STATUS=device/+/status
MQTT_TOPIC_CHAT_REQUEST=device/+/chat/request
MQTT_REJECT_UNAUTHORIZED=false

# ============================================================================
# AI engine — runs on every Node request through `services/ai`
# ============================================================================
# Powered by LangChain deepagents. LLM must be OpenAI-compatible (Ollama
# works via its built-in /v1 proxy).
#
# Switch the active model by setting MODEL + restart the dev server.
# Settings UI at /settings still controls temperature / thinking / max
# tokens at runtime.
#
# MODEL may be prefixed with `openai:` (the prefix is stripped).
#
# Examples:
#   Ollama (default) : API_KEY=ollama          BASE_URL=http://localhost:11434   MODEL=openai:qwen3.5:4b-mlx
#   OpenAI           : API_KEY=sk-...          BASE_URL=https://api.openai.com   MODEL=openai:gpt-4o-mini
#   DeepSeek         : API_KEY=sk-...          BASE_URL=https://api.deepseek.com  MODEL=openai:deepseek-chat
#   LM Studio        : API_KEY=lmstudio        BASE_URL=http://localhost:1234     MODEL=openai:local-model
#
# BASE_URL is the HOST ROOT — the engine appends `/v1` itself. Do NOT include
# `/v1` in BASE_URL or you'll get `404 page not found` from Ollama.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434
# Ollama's default context is 4096 tokens. The OpenAI-compatible /v1 API cannot
# set num_ctx, so create a derived model and point LLM_MODEL at it:
#   printf 'FROM qwen3.5:4b-mlx\nPARAMETER num_ctx 16384\n' | ollama create andy-companion -f -
LLM_MODEL=openai:andy-companion:latest
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2048

# 32-byte base64 key used to encrypt LLM provider API keys at rest in
# Postgres. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required when the user stores a cloud API key via /settings.
LLM_ENCRYPTION_KEY=
# LLM_THINKING_NORMAL={"chat_template_kwargs":{"thinking":{"type":"disabled"}}}
# LLM_THINKING_DEEP={"chat_template_kwargs":{"thinking":{"type":"enabled"}}}

# Filesystem backend + skills directory (used by deepagents).
AGENT_ROOT_DIR=./work_dir
AGENT_SKILLS_DIR=./skills

# ============================================================================
# Emotion (text classifier injected into LLM system prompt)
# ============================================================================
# Leave EMOTION_API_KEY blank to use the MockEmotionProvider (always returns
# "neutral"). When set, EMOTION_API_URL receives POST {text} and must return
# {label, confidence}. Labels: neutral|happy|sad|angry|anxious|curious|tired|unknown
EMOTION_API_KEY=
EMOTION_API_URL=
EMOTION_TIMEOUT_MS=5000

# ============================================================================
# RAG (per-device knowledge base)
# ============================================================================
# Where the per-device SQLite files live. Default `./data/`. Each device
# gets its own file `esp32-001.db` etc. — no cross-device leakage.
RAG_DATA_DIR=./data

# Embedding model. Must already be pulled into Ollama.
# qwen3-embedding:8b (4096-dim, multilingual) is the default.
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_TIMEOUT_MS=30000

# ============================================================================
# Knowledge mode (per-patient knowledge base)
# ============================================================================
# "wiki" (default) — file-based LLM Wiki under work_dir/patients/<device>/
# "rag"            — existing per-device sqlite-vec retrieval
knowledge_type=wiki

# ============================================================================
# Chat history context window (per-device, per-day)
# ============================================================================
# How many recent messages are replayed into the prompt, and the max chars
# kept per message (long assistant replies are truncated with "…").
CHAT_HISTORY_LIMIT=8
CHAT_HISTORY_MAX_CHARS=500

# ============================================================================
# xiaozhi-esp32 backend (M0 protocol skeleton)
# ============================================================================
# Public URL the device uses to reach this server's OTA + internal endpoints.
XIAOZHI_OTA_BASE_URL=http://localhost:3000

# MQTT broker dedicated to xiaozhi-esp32 (can share the EMQX Cloud above).
XIAOZHI_MQTT_BROKER=ie0e7e23.ala.cn-shenzhen.emqxsl.cn
XIAOZHI_MQTT_PORT=8883
XIAOZHI_MQTT_USERNAME=root
XIAOZHI_MQTT_PASSWORD=your_password_here
XIAOZHI_MQTT_CLIENT_ID=andy-studio-xiaozhi
XIAOZHI_LEGACY_GATEWAY=false

# WebSocket fallback endpoint (devices receive mqtt+websocket blocks regardless).
XIAOZHI_WS_URL=wss://your-public-host/api/v1/internal/ws

# JWT secret used to sign device tokens (>=32 bytes).
XIAOZHI_JWT_SECRET=change-me-to-a-32-byte-secret-please

# Seed used to derive the device HMAC key from serial_number during activation.
# Change per-environment; the same value is used by the firmware's HMAC_KEY0
# derivation if you want symmetry. For dev, any 32+ byte string is fine.
XIAOZHI_HMAC_SEED=dev-hmac-seed-32bytes-minimum-please

XIAOZHI_DEVICE_TOKEN_TTL_DAYS=7
XIAOZHI_ACTIVATION_TTL_MIN=10

# Set to "true" to route the device reply pipeline through the streaming
# path (the agent's graph-state stream is consumed so tool/model steps keep
# flowing). Either way the reply is synthesized in ONE TTS request: the
# server never slices the LLM output into sentences. Streaming needs a server
# with DOUBAO_TTS_* configured AND Ollama exposing its OpenAI-compatible
# /v1/chat/completions stream mode (default). Leave false until you've
# confirmed audio round-trips work end-to-end on your hardware.
XIAOZHI_STREAM_REPLY=false
# Graph-state streaming from local Ollama can have long quiet tool/model steps.
# Defaults are 120s for the local provider (60s/45s for other providers); set
# either value only after measuring actual model and tool latency.
# XIAOZHI_LLM_FIRST_CHUNK_TIMEOUT_MS=120000
# XIAOZHI_LLM_CHUNK_TIMEOUT_MS=120000

# NOTE: the server no longer splits replies into sentences. The entire LLM
# output is handed to TTS in a single request, and `XIAOZHI_MIN_SENTENCE_CHARS`
# / `XIAOZHI_FIRST_TTS_MIN_CHARS` were removed with that behaviour.

# --- Local (Ollama) agent loop -------------------------------------------------
# The local provider runs its own tool-calling loop instead of the DeepAgent
# graph, so it needs explicit context budgets: Ollama usually serves a 4096-token
# window and the persona/RULES prompt already consumes much of it.
# Max tool-calling steps before forcing a final answer.
# LOCAL_AGENT_MAX_STEPS=6
# Recent conversation turns replayed to the local model (truncated per turn).
# LOCAL_AGENT_HISTORY_TURNS=4
# LOCAL_AGENT_HISTORY_CHARS=160
# Max characters of pre-fetched patient record injected as grounding context.
# LOCAL_AGENT_RECORD_CHARS=1200
# Temperature used when the answer must be grounded in the patient record.
# Low values keep small models from inventing detail; -1 keeps the global setting.
# LOCAL_AGENT_GROUNDED_TEMPERATURE=0.15
# Maximum time the optional emotion classifier may occupy before the chat path
# uses neutral tone. Keep low for voice interaction.
EMOTION_BUDGET_MS=120
# Set true only when every turn needs a full patient dossier; otherwise the
# retrieval tool fetches relevant records on demand and keeps first-token fast.
AI_EAGER_PATIENT_DOSSIER=false

# ============================================================================
# Doubao (火山引擎) ASR + TTS — M3
# ============================================================================
# Create an app in the 火山引擎控制台 to get these:
#   https://console.volcengine.com/speech/app
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=

# ASR resource ID; volc.seedasr.auc = 豆包录音文件识别模型2.0
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.auc

# TTS voice + cluster. See https://www.volcengine.com/docs/6561/1257584
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_VOICE=zh_male_M392_conversation_wvae_bigtts

# ASR polling (server-side submit-then-poll loop)
DOUBAO_ASR_POLL_MS=600
DOUBAO_ASR_MAX_POLLS=30
DOUBAO_TIMEOUT_MS=15000

# ffmpeg binary (used to transcode Volcengine MP3 → firmware-friendly Opus 16kHz)
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ============================================================================
# Postgres (xiaozhi tables live here) + Redis (planned for M2)
# ============================================================================
DATABASE_URL=postgresql://andy:andy_dev_password@localhost:5432/andy_studio?schema=public
# REDIS_URL=redis://127.0.0.1:6379
